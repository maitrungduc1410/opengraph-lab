{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opengraph-lab",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": false }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  }
}
